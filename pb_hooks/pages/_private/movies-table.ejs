<!-- Movies Table -->
<div class="w-full overflow-y-auto overflow-x-auto bg-base-100/40 rounded-xl border border-base-content/5 shadow-lg backdrop-blur-sm scrollbar-thin scrollbar-thumb-base-content/10 scrollbar-track-transparent transition-all duration-200"
    :class="{ 
        'h-[calc(100vh-8.5rem)] md:h-[calc(100vh-6.5rem)]': headerVisible, 
        'h-[calc(100vh-4.5rem)] md:h-screen': !headerVisible
    }">
    <table class="table w-full">
        <!-- head -->
        <thead>
            <% const sortableColumns=[ { label: 'Watched On' , key: 'watched_at' }, { label: 'Title' , key: 'title' }, {
                label: 'Release Date' , key: 'release_date' }, { label: 'Runtime' , key: 'runtime' }, { label: 'Score' ,
                key: 'tmdb_score' } ]; %>
                <tr class="bg-base-300 shadow-sm border-b border-base-content/10">
                    <th class="sticky z-30 bg-base-300 backdrop-blur-md" style="top: 0">Poster
                    </th>
                    <% sortableColumns.forEach(col=> { %>
                        <th class="sticky z-30 bg-base-300 backdrop-blur-md" style="top: 0">
                            <button type=" button" @click.prevent="sortBy('<%= col.key %>')"
                                class="flex items-center gap-1 hover:text-yellow-700 dark:hover:text-primary cursor-pointer select-none bg-transparent border-none p-0 font-inherit">
                                <%= col.label %> <span class="opacity-50 text-xs"
                                        x-text="getSortIcon('<%= col.key %>')"></span>
                            </button>
                        </th>
                        <% }); %>

                            <!-- Member Columns -->
                            <% if (data.members && data.members.length> 0) { %>
                                <% data.members.forEach(member=> { %>
                                    <th class="sticky z-30 bg-base-300 backdrop-blur-md text-center" style="top: 0">
                                        <div class="flex flex-col items-center cursor-pointer hover:opacity-80 transition-opacity"
                                            @click.prevent="sortByUser('<%= member.id %>')"
                                            title="Sort by <%= member.name %>'s rating">
                                            <div class="avatar placeholder">
                                                <div class="mask mask-squircle bg-neutral text-neutral-content w-8 h-8 ring ring-offset-base-100 ring-offset-2"
                                                    :class="sortColumn === 'user_<%= member.id %>' ? 'ring-primary' : 'ring-transparent'">
                                                    <% if (member.avatar) { %>
                                                        <img src="/api/files/users/<%= member.id %>/<%= member.avatar %>"
                                                            alt="<%= member.name %>" />
                                                        <% } else { %>
                                                            <span class="text-xs">
                                                                <%= member.name.charAt(0).toUpperCase() %>
                                                            </span>
                                                            <% } %>
                                                </div>
                                            </div>
                                            <span class="text-[10px] opacity-70 mt-1 max-w-[60px] truncate">
                                                <%= member.name %>
                                                    <span x-show="sortColumn === 'user_<%= member.id %>'"
                                                        x-text="sortDirection === 'asc' ? '↑' : '↓'"
                                                        class="text-[9px]"></span>
                                            </span>
                                        </div>
                                    </th>
                                    <% }) %>
                                        <% } %>

                                            <th class="sticky z-30 bg-base-300 backdrop-blur-md" style="top: 0">
                                            </th>
                </tr>
        </thead>
        <tbody>
            <template x-for="(movie, index) in movies" :key="movie.history_id + '-' + index">
                <tr class="hover transition-colors duration-200">
                    <td>
                        <div class="avatar">
                            <div class="mask mask-squircle-sm w-12 h-18 bg-base-300/80 flex items-center justify-center overflow-hidden border border-base-content/5 shadow-inner relative">
                                <img x-show="movie.poster_path" :src="movie.poster_path ? 'https://image.tmdb.org/t/p/w92' + movie.poster_path : ''" :alt="movie.title"
                                    loading="lazy" decoding="async" class="w-full h-full object-cover">
                                <div x-show="!movie.poster_path" class="absolute inset-0 flex flex-col items-center justify-center bg-gradient-to-br from-base-300 via-base-200 to-base-300 text-base-content/40 p-1 select-none text-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mb-0.5 opacity-60 text-primary/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                    </svg>
                                    <span class="text-[8px] font-semibold tracking-wider uppercase opacity-60 leading-none">No Poster</span>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="flex items-center gap-2">
                            <span x-text="formatDate(movie.watched_at)"></span>
                        </div>
                    </td>
                    <td>
                        <div class="font-bold text-lg">
                            <a :href="'/movies/' + movie.tmdb_id"
                                class="hover:text-yellow-700 dark:hover:text-primary hover:underline transition-colors" x-text="movie.title"></a>
                        </div>
                        <div x-show="movie.tagline" class="text-sm opacity-60 italic max-w-xs truncate" :title="movie.tagline"
                            x-text="movie.tagline">
                        </div>
                    </td>
                    <td x-text="formatDate(movie.release_date)"></td>
                    <td x-text="movie.runtime ? movie.runtime + ' min' : 'N/A'">
                    </td>
                    <td>
                        <div class="flex flex-col gap-1">
                            <a :href="'https://www.themoviedb.org/movie/' + (movie.tmdb_id || movie.id)"
                               target="_blank" rel="noopener noreferrer"
                               class="badge badge-sm badge-ghost rounded-[4px] py-1 px-2 h-auto whitespace-nowrap hover:badge-warning transition-colors"
                               title="View on TMDB">TMDB:
                                <span class="ml-1" x-text="movie.tmdb_score ? Number(movie.tmdb_score).toFixed(1) : '-'"></span>
                            </a>
                            <a :href="movie.imdb_id ? 'https://www.imdb.com/title/' + movie.imdb_id + '/' : 'https://www.imdb.com/find/?q=' + encodeURIComponent(movie.title)"
                               target="_blank" rel="noopener noreferrer"
                               class="badge badge-sm badge-ghost rounded-[4px] py-1 px-2 h-auto whitespace-nowrap hover:badge-accent transition-colors"
                               title="View on IMDb">IMDB:
                                <span class="ml-1" x-text="movie.imdb_score ? Number(movie.imdb_score).toFixed(1) : '-'"></span>
                            </a>
                            <a :href="'https://www.rottentomatoes.com/search?search=' + encodeURIComponent(movie.title)"
                               target="_blank" rel="noopener noreferrer"
                               class="badge badge-sm badge-ghost rounded-[4px] py-1 px-2 h-auto whitespace-nowrap hover:badge-error transition-colors"
                               title="View on Rotten Tomatoes">RT:
                                <span class="ml-1" x-text="(movie.rt_score !== null && movie.rt_score !== undefined && movie.rt_score >= 0) ? movie.rt_score + '%' : '-'"></span>
                            </a>
                        </div>
                    </td>

                    <!-- Member Data Cells -->
                    <% if (data.members && data.members.length> 0) { %>
                        <% data.members.forEach(member=> { %>
                            <td class="text-center p-0 align-middle">
                                <button type="button" @click.stop="openRatingModal(movie, '<%= member.id %>', '<%= (member.name || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'") %>')"
                                    class="w-full h-full flex flex-col items-center justify-center p-2 min-h-[60px] hover:bg-base-content/5 transition-colors cursor-pointer rounded-lg bg-transparent border-none">
                                    <div x-show="movie.attendance && movie.attendance['<%= member.id %>']" class="flex flex-col items-center gap-1 pointer-events-none">
                                        <div x-show="movie.attendance && movie.attendance['<%= member.id %>'] && movie.attendance['<%= member.id %>'].rating !== null && movie.attendance['<%= member.id %>'].rating !== undefined && movie.attendance['<%= member.id %>'].rating >= 0"
                                            class="badge badge-sm rounded-md font-bold"
                                            :class="movie.attendance && movie.attendance['<%= member.id %>'] && movie.attendance['<%= member.id %>'].failed ? 'badge-error' : 'badge-success'"
                                            x-text="movie.attendance && movie.attendance['<%= member.id %>'] && movie.attendance['<%= member.id %>'].rating >= 0 ? formatRating(movie.attendance['<%= member.id %>'].rating) + '/10' : ''">
                                        </div>

                                        <svg x-show="movie.attendance && movie.attendance['<%= member.id %>'] && !movie.attendance['<%= member.id %>'].failed"
                                            xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-success"
                                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>

                                        <svg x-show="movie.attendance && movie.attendance['<%= member.id %>'] && movie.attendance['<%= member.id %>'].failed"
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-6 w-6 text-error opacity-50" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                        </svg>

                                        <!-- Review Indicator -->
                                        <div x-show="movie.attendance && movie.attendance['<%= member.id %>'] && movie.attendance['<%= member.id %>'].review"
                                            class="tooltip tooltip-bottom z-50 pointer-events-auto"
                                            :data-tip="movie.attendance && movie.attendance['<%= member.id %>'] ? movie.attendance['<%= member.id %>'].review : ''">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 text-primary opacity-80" viewBox="0 0 20 20"
                                                fill="currentColor">
                                                <path fill-rule="evenodd"
                                                    d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                        </div>
                                    </div>
                                    <span x-show="!movie.attendance || !movie.attendance['<%= member.id %>']"
                                        class="text-base-content/40"
                                        :class="{'text-xs italic font-semibold text-amber-800 dark:text-amber-300 hover:underline': isOwner && '<%= member.id %>' === currentUserId}"
                                        x-text="isOwner && '<%= member.id %>' === currentUserId ? 'Rate' : '-'"></span>
                                </button>
                            </td>
                            <% }) %>
                                <% } %>

                                    <td>
                                        <button x-show="isOwner" @click="openEditMovieModal(movie)"
                                            class="btn btn-xs btn-ghost btn-square mask mask-squircle opacity-50 hover:opacity-100"
                                            title="Edit Entry">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                                                viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                            </svg>
                                        </button>
                                    </td>
                </tr>
            </template>
        </tbody>
    </table>

    <!-- Scroll Sentinel for Infinite Scroll -->
    <div id="scroll-sentinel" class="w-full py-4">
        <div x-show="isLoading" class="flex justify-center items-center py-8">
            <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>
        <div x-show="!hasMore && movies.length > 0 && !isLoading" class="text-center py-4 text-base-content/65">
            <p>You've reached the end of the list</p>
        </div>
    </div>
</div>