<%# Add to Watchlist Modal Partial Parameters: - showModalVar: Alpine.js variable name for modal
    (default: 'showAddModal' ) - tmdbId: Fixed TMDB movie ID value - tmdbIdRef: Alpine.js x-ref name for dynamic tmdb_id
    input - formAction: Form action URL (default: '/movies/search' ) - queryParam: Search query to preserve - lists:
    Custom lists array (defaults to userWatchlists from middleware) %>

    <% const modalVar=locals.showModalVar || 'showAddModal' ; const action=locals.formAction || '/movies/search' ; const
        watchlists=locals.lists || (locals.data && locals.data.userWatchlists) || locals.userWatchlists || []; %>

        <!-- Add to Watchlist Modal -->
        <div x-show="<%= modalVar %>" x-cloak x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm"
            @click.self="<%= modalVar %> = false" @keydown.escape.window="<%= modalVar %> = false">

            <div x-show="<%= modalVar %>" x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100"
                x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 scale-100"
                x-transition:leave-end="opacity-0 scale-95"
                class="relative w-full max-w-md rounded-2xl border border-base-content/10 bg-base-200/95 p-6 shadow-2xl backdrop-blur-xl mx-4">

                <div class="mb-4 flex items-center justify-between">
                    <h3 class="text-xl font-bold">Add to Watchlist</h3>
                    <button @click="<%= modalVar %> = false" class="btn btn-circle btn-ghost btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <p class="mb-4 text-base-content/60">Select a watchlist for this movie:</p>

                <div class="flex flex-col gap-3 max-h-[60vh] overflow-y-auto pr-2">
                    <form method="POST" action="<%= action %>" id="addToWatchlistForm">
                        <% if (locals.tmdbId) { %>
                            <input type="hidden" name="tmdb_id" value="<%= locals.tmdbId %>" />
                            <% } else if (locals.tmdbIdRef) { %>
                                <input type="hidden" name="tmdb_id" x-ref="<%= locals.tmdbIdRef %>" />
                                <% } %>
                                    <% if (locals.queryParam) { %>
                                        <input type="hidden" name="q" value="<%= locals.queryParam %>" />
                                        <% } %>

                                            <!-- Default List -->
                                            <button type="submit" name="watchlist_id" value=""
                                                class="btn btn-outline w-full justify-between hover:bg-primary hover:text-primary-content group transition-all">
                                                <span class="flex items-center gap-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                        class="h-5 w-5 text-primary group-hover:text-primary-content"
                                                        viewBox="0 0 20 20" fill="currentColor">
                                                        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" />
                                                    </svg>
                                                    Default Watchlist
                                                </span>
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                    class="h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity"
                                                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M12 4v16m8-8H4" />
                                                </svg>
                                            </button>

                                            <!-- Custom Lists -->
                                            <% if (watchlists.length> 0) { %>
                                                <div class="divider text-xs opacity-50 my-2">Custom Lists</div>
                                                <% watchlists.forEach(list=> { %>
                                                    <button type="submit" name="watchlist_id" value="<%= list.id %>"
                                                        class="btn btn-outline w-full justify-between hover:bg-secondary hover:text-secondary-content group transition-all mb-2">
                                                        <span class="flex items-center gap-2">
                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                class="h-5 w-5 text-secondary group-hover:text-secondary-content"
                                                                fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2"
                                                                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                                            </svg>
                                                            <%= list.list_title %>
                                                        </span>
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                            class="h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity"
                                                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2" d="M12 4v16m8-8H4" />
                                                        </svg>
                                                    </button>
                                                    <% }) %>
                                                        <% } %>
                    </form>
                </div>
            </div>
        </div>