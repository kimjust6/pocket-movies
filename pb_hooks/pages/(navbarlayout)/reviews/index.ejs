<%
    const initialReviews = (data && data.reviews) || [];
    const stats = (data && data.stats) || { total: 0, avgScore: '-', uniqueMovies: 0 };
%>

<script id="reviews-data" type="application/json">
<%- JSON.stringify(initialReviews) %>
</script>

<div class="min-h-screen bg-base-200/40 pb-20 pt-8"
     x-data="reviewsView()">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumb / Back Link -->
        <div class="mb-6 flex items-center justify-between">
            <nav class="text-sm breadcrumbs">
                <ul>
                    <li><a href="/" class="text-base-content/70 hover:text-primary">Home</a></li>
                    <li class="font-semibold text-primary">Community Reviews</li>
                </ul>
            </nav>
            <a href="/movies/search" class="btn btn-sm btn-ghost gap-2 text-base-content/70 hover:text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Find Movie to Review
            </a>
        </div>

        <!-- Hero Header -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-base-100 via-base-100 to-base-300 p-6 md:p-10 shadow-xl border border-base-content/5 mb-8">
            <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
            <div class="absolute -left-16 -bottom-16 h-64 w-64 rounded-full bg-secondary/10 blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="max-w-2xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold tracking-wider uppercase mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
                        </svg>
                        Latest Impressions
                    </div>
                    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-base-content leading-tight">
                        Community <span class="bg-gradient-to-r from-primary via-amber-400 to-warning bg-clip-text text-transparent">Reviews</span>
                    </h1>
                    <p class="mt-3 text-base sm:text-lg text-base-content/70 font-light leading-relaxed">
                        Discover what members are watching, rating, and saying about films in their watchlists.
                    </p>
                </div>

                <!-- Stats Overview -->
                <div class="grid grid-cols-3 gap-3 sm:gap-4 shrink-0 bg-base-200/60 p-4 rounded-2xl border border-base-content/5 backdrop-blur-sm">
                    <div class="text-center px-2">
                        <span class="block text-2xl sm:text-3xl font-black text-primary" x-text="reviews.length"><%= stats.total %></span>
                        <span class="text-xs uppercase tracking-wider text-base-content/60 font-medium">Reviews</span>
                    </div>
                    <div class="text-center px-2 border-x border-base-content/10">
                        <span class="block text-2xl sm:text-3xl font-black text-warning flex items-center justify-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            <span><%= stats.avgScore %></span>
                        </span>
                        <span class="text-xs uppercase tracking-wider text-base-content/60 font-medium">Avg Score</span>
                    </div>
                    <div class="text-center px-2">
                        <span class="block text-2xl sm:text-3xl font-black text-secondary"><%= stats.uniqueMovies %></span>
                        <span class="text-xs uppercase tracking-wider text-base-content/60 font-medium">Films</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter, Search & Controls Bar -->
        <div class="card bg-base-100 shadow-md border border-base-content/5 p-4 mb-8">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                
                <!-- Search Box -->
                <div class="relative flex-1 max-w-lg">
                    <input type="text"
                           x-model="searchQuery"
                           placeholder="Filter by movie, reviewer, or review text..."
                           class="input input-bordered w-full pl-10 pr-9 bg-base-200/50 focus:bg-base-100 text-sm" />
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <button x-show="searchQuery"
                            @click="searchQuery = ''"
                            class="btn btn-ghost btn-xs btn-circle absolute right-2.5 top-1/2 -translate-y-1/2 text-base-content/50 hover:text-base-content">
                        ✕
                    </button>
                </div>

                <!-- Filter Pills -->
                <div class="flex flex-wrap items-center gap-2">
                    <div class="join">
                        <button type="button"
                                @click="filterType = 'all'"
                                class="btn btn-sm join-item"
                                :class="filterType === 'all' ? 'btn-primary' : 'btn-ghost bg-base-200/50'">
                            All
                        </button>
                        <button type="button"
                                @click="filterType = 'text_only'"
                                class="btn btn-sm join-item"
                                :class="filterType === 'text_only' ? 'btn-primary' : 'btn-ghost bg-base-200/50'">
                            With Thoughts
                        </button>
                        <button type="button"
                                @click="filterType = 'top_rated'"
                                class="btn btn-sm join-item"
                                :class="filterType === 'top_rated' ? 'btn-primary' : 'btn-ghost bg-base-200/50'">
                            ★ 8.0+
                        </button>
                    </div>

                    <!-- Sort Select -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold uppercase text-base-content/50 hidden sm:inline">Sort:</span>
                        <select x-model="sortOrder"
                                class="select select-bordered select-sm bg-base-200/50 focus:bg-base-100 font-medium">
                            <option value="-created">Newest First</option>
                            <option value="created">Oldest First</option>
                            <option value="-rating">Highest Rating</option>
                            <option value="rating">Lowest Rating</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Active results counter -->
            <div class="mt-3 pt-3 border-t border-base-content/5 flex items-center justify-between text-xs text-base-content/60">
                <div>
                    Showing <span class="font-bold text-base-content" x-text="filteredReviews.length"></span> of <span class="font-bold text-base-content" x-text="reviews.length"><%= initialReviews.length %></span> reviews
                </div>
                <div x-show="searchQuery || filterType !== 'all'">
                    <button @click="resetFilters()" class="hover:text-primary hover:underline transition-colors">
                        Reset filters
                    </button>
                </div>
            </div>
        </div>

        <!-- Reviews Grid / Feed -->
        <div class="space-y-6">
            <template x-for="item in filteredReviews" :key="item.id">
                <article class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 border border-base-content/5 overflow-hidden">
                    <div class="card-body p-5 sm:p-7">
                        <div class="flex flex-col sm:flex-row gap-5 items-start">
                            
                            <!-- Movie Poster -->
                            <div class="shrink-0 w-24 sm:w-28 aspect-[2/3] mask mask-squircle-poster bg-base-300 shadow-md hover:scale-105 transition-transform duration-300 relative group overflow-hidden">
                                <a :href="'/movies/' + item.movie.tmdbId" class="block w-full h-full">
                                    <template x-if="item.movie.posterPath">
                                        <img :src="'https://image.tmdb.org/t/p/w342' + item.movie.posterPath"
                                             :alt="item.movie.title"
                                             loading="lazy"
                                             class="w-full h-full object-cover" />
                                    </template>
                                    <template x-if="!item.movie.posterPath">
                                        <div class="w-full h-full flex flex-col items-center justify-center p-2 text-center bg-base-300 text-base-content/40 select-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mb-1 opacity-30 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                            </svg>
                                            <span class="text-[10px] font-semibold uppercase tracking-wider">No Poster</span>
                                        </div>
                                    </template>
                                </a>
                            </div>

                            <!-- Content Column -->
                            <div class="flex-1 min-w-0 w-full">
                                
                                <!-- Header Row: User Info, Watchlist & Date -->
                                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                                    
                                    <!-- User Avatar & Name -->
                                    <div class="flex items-center gap-3">
                                        <a :href="item.user.id ? '/profile/' + item.user.id : '#'"
                                           class="avatar placeholder hover:opacity-80 transition-opacity"
                                           :title="'View ' + item.user.name + '\'s profile'">
                                            <template x-if="item.user.avatarUrl">
                                                <div class="w-10 h-10 mask mask-squircle ring-2 ring-primary/40 ring-offset-base-100 ring-offset-1">
                                                    <img :src="item.user.avatarUrl" :alt="item.user.name" class="object-cover" />
                                                </div>
                                            </template>
                                            <template x-if="!item.user.avatarUrl">
                                                <div class="w-10 h-10 mask mask-squircle bg-gradient-to-br from-primary to-warning text-primary-content font-bold flex items-center justify-center text-sm shadow-sm">
                                                    <span x-text="item.user.initials"></span>
                                                </div>
                                            </template>
                                        </a>

                                        <div>
                                            <div class="flex items-center gap-2">
                                                <a :href="item.user.id ? '/profile/' + item.user.id : '#'"
                                                   class="font-bold text-sm sm:text-base text-base-content hover:text-primary transition-colors hover:underline inline-block"
                                                   :title="'View ' + item.user.name + '\'s profile'"
                                                   x-text="item.user.name"></a>
                                                <template x-if="item.failed">
                                                    <span class="badge badge-error badge-xs font-semibold gap-1">
                                                        Bailed
                                                    </span>
                                                </template>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs text-base-content/60">
                                                <span x-text="item.formattedDate"></span>
                                                <template x-if="item.list">
                                                    <span class="flex items-center gap-1">
                                                        <span>•</span>
                                                        <a :href="item.list.url"
                                                           class="hover:text-primary transition-colors truncate max-w-[150px] sm:max-w-xs"
                                                           x-text="item.list.title"></a>
                                                    </span>
                                                </template>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Rating Score Pill & Star Badges -->
                                    <div class="flex items-center gap-2">
                                        <template x-if="item.rating !== null && item.rating !== undefined && item.rating >= 0">
                                            <div class="flex items-center gap-2 bg-base-200/80 px-3 py-1.5 rounded-xl border border-base-content/5">
                                                <!-- Stars display -->
                                                <div class="flex items-center text-warning">
                                                    <template x-for="star in 5" :key="star">
                                                        <svg xmlns="http://www.w3.org/2000/svg"
                                                             class="h-4 w-4"
                                                             :class="(item.rating / 2) >= star ? 'fill-warning text-warning' : ((item.rating / 2) >= (star - 0.5) ? 'fill-warning/50 text-warning' : 'text-base-content/20')"
                                                             viewBox="0 0 20 20"
                                                             fill="currentColor">
                                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                        </svg>
                                                    </template>
                                                </div>
                                                <span class="font-extrabold text-sm text-base-content" x-text="Number(item.rating).toFixed(1) + ' / 10'"></span>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Movie Title & Year -->
                                <div class="mb-3">
                                    <a :href="'/movies/' + item.movie.tmdbId"
                                       class="text-lg sm:text-xl font-black text-base-content hover:text-primary transition-colors inline-flex items-center gap-2 group">
                                        <span x-text="item.movie.title"></span>
                                        <span x-show="item.movie.releaseYear"
                                              class="text-sm font-normal text-base-content/50"
                                              x-text="'(' + item.movie.releaseYear + ')'"></span>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                        </svg>
                                    </a>
                                </div>

                                <!-- Review Body -->
                                <template x-if="item.review">
                                    <div class="relative bg-base-200/40 rounded-2xl p-4 sm:p-5 border border-base-content/5 text-base-content/90 font-serif leading-relaxed">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary/30 absolute top-3 left-3 -scale-x-100 select-none pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                                        </svg>
                                        <div class="pl-5 text-sm sm:text-base">
                                            <p x-text="isExpanded(item.id) || item.review.length <= 260 ? item.review : item.review.slice(0, 260) + '...'"></p>
                                            <button x-show="item.review.length > 260"
                                                    @click="toggleExpand(item.id)"
                                                    class="btn btn-link btn-xs p-0 mt-2 font-sans font-semibold text-primary no-underline hover:underline">
                                                <span x-text="isExpanded(item.id) ? 'Show less' : 'Read more'"></span>
                                            </button>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="!item.review">
                                    <div class="text-xs italic text-base-content/50 py-1">
                                        Rated without written review.
                                    </div>
                                </template>

                                <!-- Footer actions -->
                                <div class="mt-4 flex items-center justify-between pt-3 border-t border-base-content/5">
                                    <div class="flex items-center gap-3">
                                        <a :href="'/movies/' + item.movie.tmdbId"
                                           class="btn btn-xs btn-ghost gap-1.5 text-base-content/70 hover:text-primary">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            Movie Info
                                        </a>

                                        <template x-if="item.list">
                                            <a :href="item.list.url"
                                               class="btn btn-xs btn-ghost gap-1.5 text-base-content/70 hover:text-secondary">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                                </svg>
                                                View Watchlist
                                            </a>
                                        </template>
                                    </div>

                                    <template x-if="item.movie.tmdbScore">
                                        <div class="text-xs text-base-content/50 flex items-center gap-1 font-mono">
                                            <span>TMDB</span>
                                            <span class="font-bold text-base-content" x-text="item.movie.tmdbScore.toFixed(1)"></span>
                                        </div>
                                    </template>
                                </div>

                            </div>
                        </div>
                    </div>
                </article>
            </template>

            <!-- Empty State -->
            <div x-show="filteredReviews.length === 0"
                 x-cloak
                 class="card bg-base-100 shadow-md border border-base-content/5 p-12 text-center">
                <div class="mx-auto w-16 h-16 rounded-full bg-base-200 flex items-center justify-center text-base-content/30 mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-base-content mb-2">No reviews found</h3>
                <p class="text-base-content/60 max-w-md mx-auto mb-6 text-sm">
                    <span x-show="searchQuery || filterType !== 'all'">No reviews match your current filters. Try changing or clearing your search query.</span>
                    <span x-show="!searchQuery && filterType === 'all'">There are no community reviews recorded yet. Watch a movie and be the first to share your thoughts!</span>
                </p>
                <div>
                    <button x-show="searchQuery || filterType !== 'all'"
                            @click="resetFilters()"
                            class="btn btn-outline btn-sm">
                        Clear Filters
                    </button>
                    <a x-show="!searchQuery && filterType === 'all'"
                       href="/watchlists"
                       class="btn btn-primary btn-sm gap-2">
                        Browse Watchlists
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function reviewsView() {
        let initialItems = [];
        try {
            const el = document.getElementById('reviews-data');
            if (el && el.textContent) {
                initialItems = JSON.parse(el.textContent);
            }
        } catch (e) {
            console.error('Failed to parse reviews data:', e);
        }

        return {
            reviews: Array.isArray(initialItems) ? initialItems : [],
            searchQuery: '',
            filterType: 'all',
            sortOrder: '-created',
            expandedMap: {},

            init() {
                // Check URL query parameters for initial state
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('filter')) {
                    this.filterType = urlParams.get('filter');
                }
                if (urlParams.get('sort')) {
                    this.sortOrder = urlParams.get('sort');
                }
                if (urlParams.get('q')) {
                    this.searchQuery = urlParams.get('q');
                }
            },

            isExpanded(id) {
                return !!this.expandedMap[id];
            },

            toggleExpand(id) {
                this.expandedMap[id] = !this.expandedMap[id];
            },

            resetFilters() {
                this.searchQuery = '';
                this.filterType = 'all';
                this.sortOrder = '-created';
            },

            get filteredReviews() {
                let list = [...this.reviews];

                // 1. Filter type
                if (this.filterType === 'text_only') {
                    list = list.filter(item => item.hasReview && item.review.trim().length > 0);
                } else if (this.filterType === 'top_rated') {
                    list = list.filter(item => item.rating !== null && item.rating >= 8.0);
                }

                // 2. Search query filter
                if (this.searchQuery.trim().length > 0) {
                    const q = this.searchQuery.toLowerCase().trim();
                    list = list.filter(item => {
                        const movieTitle = (item.movie?.title || '').toLowerCase();
                        const userName = (item.user?.name || '').toLowerCase();
                        const reviewText = (item.review || '').toLowerCase();
                        const listTitle = (item.list?.title || '').toLowerCase();
                        return movieTitle.includes(q) || userName.includes(q) || reviewText.includes(q) || listTitle.includes(q);
                    });
                }

                // 3. Sorting
                list.sort((a, b) => {
                    if (this.sortOrder === '-rating') {
                        return (b.rating ?? -1) - (a.rating ?? -1);
                    }
                    if (this.sortOrder === 'rating') {
                        return (a.rating ?? 999) - (b.rating ?? 999);
                    }
                    if (this.sortOrder === 'created') {
                        return (Date.parse(a.created) || 0) - (Date.parse(b.created) || 0);
                    }
                    // default -created (newest first)
                    return (Date.parse(b.created) || 0) - (Date.parse(a.created) || 0);
                });

                return list;
            }
        };
    }
</script>
