<%
    const profile = data.profile;
    const isOwner = !!data.isOwner;
    const userWatchlists = data.watchlists || [];
    const userReviews = data.reviews || [];
%>

<% if (data.error || !profile) { %>
    <div class="flex min-h-[60vh] flex-col items-center justify-center p-6 text-center">
        <div class="w-16 h-16 rounded-full bg-error/10 text-error flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h1 class="text-3xl font-bold text-base-content mb-2">User Not Found</h1>
        <p class="text-base-content/60 max-w-sm mb-6">The profile you are looking for does not exist or has been removed.</p>
        <a href="/reviews" class="btn btn-primary btn-sm gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Reviews
        </a>
    </div>
<% } else { %>
    <div class="relative min-h-[calc(100vh-80px)] overflow-hidden pb-16">
        <!-- Background Effects -->
        <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-base-100 to-secondary/10">
            <!-- Grid Pattern -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
            <!-- Radial Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-base-100/50 to-transparent"></div>
            <!-- Cinematic Glow -->
            <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary/15 rounded-full blur-[120px] opacity-50"></div>
        </div>

        <div class="container relative z-10 mx-auto px-4 py-8 max-w-5xl">
            
            <!-- Breadcrumbs -->
            <div class="mb-6 flex items-center justify-between">
                <nav class="text-sm breadcrumbs">
                    <ul>
                        <li><a href="/" class="text-base-content/70 hover:text-primary">Home</a></li>
                        <li><a href="/reviews" class="text-base-content/70 hover:text-primary">Reviews</a></li>
                        <li class="font-semibold text-primary"><%= profile.getString('name') || 'Profile' %></li>
                    </ul>
                </nav>
                <a href="/reviews" class="btn btn-ghost btn-sm gap-1.5 text-base-content/70 hover:text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Reviews
                </a>
            </div>

            <!-- Profile Card -->
            <div class="card border border-base-content/10 bg-base-100/70 shadow-2xl backdrop-blur-md mb-10 overflow-hidden">
                <div class="card-body p-6 sm:p-8 md:p-10">
                    <div class="flex flex-col md:flex-row gap-6 md:gap-10 items-center md:items-start">
                        
                        <!-- Left: Avatar -->
                        <div class="flex-shrink-0">
                            <div class="avatar placeholder">
                                <div class="w-28 sm:w-36 md:w-40 mask mask-squircle shadow-xl shadow-primary/10 ring-4 ring-primary/20 ring-offset-base-100 ring-offset-2">
                                    <% if (profile.getString('avatar')) { %>
                                        <img src="<%= '/api/files/' + profile.collection().id + '/' + profile.id + '/' + profile.getString('avatar') %>"
                                             alt="<%= profile.getString('name') %>" class="w-full h-full object-cover" />
                                    <% } else { %>
                                        <div class="bg-gradient-to-br from-primary to-secondary text-primary-content w-full h-full flex items-center justify-center text-4xl sm:text-5xl font-black">
                                            <%= (profile.getString('name') || profile.getString('email') || 'U').slice(0, 1).toUpperCase() %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Info -->
                        <div class="flex-grow space-y-4 w-full text-center md:text-left">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div>
                                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black bg-gradient-to-r from-base-content to-base-content/75 bg-clip-text text-transparent leading-tight">
                                        <%= profile.getString('name') || (profile.getString('email') ? profile.getString('email').split('@')[0] : 'User') %>
                                    </h1>
                                    <% const displayHandle = profile.getString('shortHand') || data.userHandle; %>
                                    <% if (displayHandle) { %>
                                        <span class="inline-block mt-0.5 text-sm font-semibold text-primary">
                                            @<%= displayHandle %>
                                        </span>
                                    <% } %>
                                </div>

                                <% if (isOwner) { %>
                                    <a href="/profile/edit"
                                       class="btn btn-secondary btn-sm gap-2 shadow-lg shadow-secondary/20 hover:scale-105 transition-all self-center sm:self-auto">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                        </svg>
                                        Edit Profile
                                    </a>
                                <% } %>
                            </div>

                            <% if (isOwner || profile.getBool('emailVisibility')) { %>
                                <p class="text-xs sm:text-sm text-base-content/60">
                                    <%= profile.getString('email') %>
                                </p>
                            <% } %>

                            <!-- Bio Section -->
                            <% if (profile.getString('bio')) { %>
                                <div class="p-4 bg-base-200/50 rounded-2xl border border-base-content/5 text-sm text-base-content/85 leading-relaxed font-normal">
                                    <%= profile.getString('bio') %>
                                </div>
                            <% } %>

                            <!-- Stats Row -->
                            <div class="stats stats-horizontal bg-base-200/60 border border-base-content/5 shadow-sm rounded-2xl overflow-hidden w-full max-w-md">
                                <div class="stat p-3 sm:p-4">
                                    <div class="stat-title text-[11px] uppercase tracking-wider">Member Since</div>
                                    <div class="stat-value text-sm sm:text-base font-bold text-primary">
                                        <%= data.formatDateTime(profile.getString('created')) %>
                                    </div>
                                </div>
                                <div class="stat p-3 sm:p-4 border-l border-base-content/5">
                                    <div class="stat-title text-[11px] uppercase tracking-wider">Reviews</div>
                                    <div class="stat-value text-sm sm:text-base font-bold text-warning">
                                        <%= userReviews.length %>
                                    </div>
                                </div>
                                <div class="stat p-3 sm:p-4 border-l border-base-content/5">
                                    <div class="stat-title text-[11px] uppercase tracking-wider">Watchlists</div>
                                    <div class="stat-value text-sm sm:text-base font-bold text-secondary">
                                        <%= userWatchlists.length %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- User's Reviews Section -->
            <div class="mb-12">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl sm:text-2xl font-bold flex items-center gap-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
                        </svg>
                        <span><%= isOwner ? 'My Reviews' : (profile.getString('name') || 'User') + "'s Reviews" %></span>
                        <span class="badge badge-primary badge-sm font-bold"><%= userReviews.length %></span>
                    </h2>

                    <a href="/reviews" class="btn btn-ghost btn-xs sm:btn-sm gap-1 text-base-content/70 hover:text-primary">
                        All Community Reviews
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>

                <% if (userReviews.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% userReviews.forEach(r => { %>
                            <div class="card bg-base-100 shadow-md border border-base-content/5 p-5 flex flex-col justify-between hover:shadow-lg transition-all duration-300">
                                <div>
                                    <div class="flex items-start gap-4 mb-3">
                                        <!-- Mini Poster -->
                                        <div class="w-14 sm:w-16 aspect-[2/3] mask mask-squircle-poster bg-base-300 shrink-0 shadow-sm overflow-hidden">
                                            <a href="/movies/<%= r.movie.tmdbId %>">
                                                <% if (r.movie.posterPath) { %>
                                                    <img src="https://image.tmdb.org/t/p/w185<%= r.movie.posterPath %>" alt="<%= r.movie.title %>" class="w-full h-full object-cover" />
                                                <% } else { %>
                                                    <div class="w-full h-full flex items-center justify-center text-[10px] opacity-40 text-center p-1 font-semibold uppercase">No Poster</div>
                                                <% } %>
                                            </a>
                                        </div>

                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-2 mb-1">
                                                <a href="/movies/<%= r.movie.tmdbId %>" class="font-bold text-base hover:text-primary transition-colors truncate">
                                                    <%= r.movie.title %>
                                                </a>
                                                <% if (r.rating !== null && r.rating !== undefined && r.rating >= 0) { %>
                                                    <div class="badge badge-warning font-bold text-xs shrink-0">
                                                        ★ <%= Number(r.rating).toFixed(1) %>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <div class="flex items-center gap-2 text-xs text-base-content/50 mb-2">
                                                <span><%= r.formattedDate %></span>
                                                <% if (r.failed) { %>
                                                    <span class="badge badge-error badge-xs font-semibold">Bailed</span>
                                                <% } %>
                                            </div>

                                            <% if (r.review) { %>
                                                <a href="/reviews/<%= r.id %>" class="block group/prev">
                                                    <p class="text-xs sm:text-sm leading-relaxed text-base-content/85 line-clamp-3 italic group-hover/prev:text-primary transition-colors font-normal">
                                                        "<%= r.review %>"
                                                    </p>
                                                    <span class="text-[11px] text-primary font-medium mt-1 inline-flex items-center gap-0.5 group-hover/prev:underline">
                                                        Full review →
                                                    </span>
                                                </a>
                                            <% } else { %>
                                                <a href="/reviews/<%= r.id %>" class="block text-xs text-base-content/40 hover:text-primary transition-colors italic">
                                                    Rated without written review • Details →
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-2 pt-2 border-t border-base-content/5 text-xs text-base-content/60 flex justify-between items-center">
                                    <span>
                                        <% if (r.list) { %>
                                            From list: <a href="<%= r.list.url %>" class="text-base-content/80 hover:text-primary font-medium"><%= r.list.title %></a>
                                        <% } %>
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <a href="/reviews/<%= r.id %>" class="text-primary hover:underline font-medium">Review →</a>
                                        <span class="text-base-content/20">•</span>
                                        <a href="/movies/<%= r.movie.tmdbId %>" class="text-base-content/60 hover:text-primary font-medium">Film →</a>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="card bg-base-100/50 border border-dashed border-base-content/15 p-8 text-center rounded-2xl">
                        <p class="text-sm text-base-content/60">No reviews shared by this user yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- User's Watchlists Section -->
            <div>
                <h2 class="text-xl sm:text-2xl font-bold mb-6 flex items-center gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
                    </svg>
                    <span><%= isOwner ? 'My Watchlists' : (profile.getString('name') || 'User') + "'s Watchlists" %></span>
                    <span class="badge badge-secondary badge-sm font-bold"><%= userWatchlists.length %></span>
                </h2>

                <% if (userWatchlists.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                        <% userWatchlists.forEach(l => { %>
                            <a href="<%= l.url %>" class="card bg-base-100 shadow-md border border-base-content/5 p-5 hover:border-secondary/40 hover:shadow-xl transition-all duration-300 group">
                                <h3 class="font-bold text-base text-base-content group-hover:text-secondary transition-colors mb-1 truncate">
                                    <%= l.title %>
                                </h3>
                                <% if (l.description) { %>
                                    <p class="text-xs text-base-content/60 line-clamp-2 mb-3">
                                        <%= l.description %>
                                    </p>
                                <% } else { %>
                                    <p class="text-xs text-base-content/40 italic mb-3">No description</p>
                                <% } %>
                                <div class="text-xs text-secondary font-semibold flex items-center gap-1 mt-auto">
                                    <span>Explore list</span>
                                    <span class="transition-transform group-hover:translate-x-1">→</span>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="card bg-base-100/50 border border-dashed border-base-content/15 p-8 text-center rounded-2xl">
                        <p class="text-sm text-base-content/60">No public watchlists available.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
<% } %>
