<!-- Hero Section with Dark Gradient Background -->
<div class="min-h-screen" id="home">
    <!-- Hero -->
    <div class="hero relative min-h-[80vh] overflow-hidden bg-gradient-to-b from-base-200 via-base-100">
        <!-- Background Pattern -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <!-- Subtle Film Reel Pattern -->
            <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:40px_40px]">
            </div>
            <!-- Cinematic Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-transparent to-transparent"></div>
            <!-- Top Glow -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] bg-primary/5 rounded-full blur-[150px]">
            </div>
        </div>

        <div class="hero-content relative z-10 py-20 text-left place-items-start">
            <div class="max-w-4xl">
                <!-- Main Headline -->
                <h1
                    class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight leading-tight text-shadow-lg">
                    <span class="text-base-content ">
                        <span class="text-primary italic">Track</span> films you've watched.
                    </span>
                    <div class="text-base-content ">
                        Share films you <span class="text-primary italic">love.</span>
                    </div>
                </h1>

                <!-- Tagline -->
                <span
                    class="text-lg md:text-xl text-base-content/60 mb-10 leading-relaxed max-w-2xl mx-auto italic text-left items-start">
                    Log, rate, and review. Create lists and share your taste with friends.
                </span>

                <!-- CTA Buttons -->
                <div class="flex flex-col justify-start gap-4 sm:flex-row pt-8">
                    <a href="/login"
                        class="btn btn-primary btn-lg gap-2 shadow-lg transition-all duration-300 hover:scale-105">
                        Get Started — It's Free
                    </a>
                    <a href="#features"
                        class="btn btn-ghost btn-lg gap-2 border border-base-content/20 transition-all duration-300 hover:border-base-content/40">
                        Learn More
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recently Watched Section -->
    <section class="bg-base-100 px-4 py-16">
        <div class="mx-auto max-w-6xl">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold">Recently Watched</h2>
                    <p class="text-base-content/60 mt-1">What the community is watching right now</p>
                </div>
                <a href="/movies/search" class="btn btn-ghost btn-sm gap-1">
                    Search Movies
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>

            <!-- Movie Posters Grid -->
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3 md:gap-4">
                <% if (data.recentMovies && data.recentMovies.length> 0) { %>
                    <% data.recentMovies.forEach(movie=> { %>
                        <a href="/movies/<%= movie.tmdb_id %>" class="group cursor-pointer block">
                            <div
                                class="aspect-[2/3] rounded-lg bg-base-200 overflow-hidden shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl relative">
                                <% if (movie.poster_path) { %>
                                    <img src="https://image.tmdb.org/t/p/w500<%= movie.poster_path %>"
                                        alt="<%= movie.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <div class="absolute inset-0 flex items-center justify-center bg-base-300">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                class="h-10 w-10 text-base-content/20" fill="none" viewBox="0 0 24 24"
                                                stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                                    d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                                            </svg>
                                        </div>
                                        <% } %>
                                            <div
                                                class="absolute bottom-0 left-0 right-0 p-2 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                                                <p class="text-white text-xs font-medium truncate">
                                                    <%= movie.title %>
                                                </p>
                                            </div>
                            </div>
                        </a>
                        <% }); %>
                            <% } else { %>
                                <!-- Fallback if no movies -->
                                <div class="col-span-full text-center py-10 text-base-content/50">
                                    <p>No recently watched movies yet.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </section>

    <!-- Featured Lists & Recent Activity Section -->
    <section class="bg-base-200/50 px-4 py-16">
        <div class="mx-auto max-w-6xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                <!-- Featured Lists -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl md:text-2xl font-bold">Featured Lists</h2>
                        <a href="/watchlists" class="btn btn-ghost btn-sm gap-1">
                            View All Lists
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                    <p class="text-base-content/60 mb-6 -mt-4">Curated collections from the community</p>

                    <div class="space-y-4">
                        <% if (data.topLists && data.topLists.length> 0) { %>
                            <% data.topLists.forEach(list=> { %>
                                <a href="<%= list.url || ('/watchlists/' + list.id) %>"
                                    class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer group">
                                    <div class="card-body p-4 flex-row items-center gap-4">
                                        <div class="flex -space-x-2">
                                            <% if (list.posters.length> 0) { %>
                                                <% list.posters.forEach(poster=> { 
                                                    let pUrl = poster || '';
                                                    if (pUrl && !pUrl.startsWith('http')) {
                                                        pUrl = 'https://image.tmdb.org/t/p/w92' + (pUrl.startsWith('/') ? '' : '/') + pUrl;
                                                    }
                                                %>
                                                    <img src="<%= pUrl %>" alt="Poster"
                                                        loading="lazy" decoding="async"
                                                        class="w-10 h-14 rounded object-cover border-2 border-base-100">
                                                    <% }); %>
                                                        <% for (let i=list.posters.length; i < 3; i++) { %>
                                                            <div
                                                                class="w-10 h-14 rounded bg-gradient-to-br from-primary/40 to-secondary/40 border-2 border-base-100">
                                                            </div>
                                                            <% } %>
                                                                <% } else { %>
                                                                    <div
                                                                        class="w-10 h-14 rounded bg-gradient-to-br from-primary/40 to-secondary/40">
                                                                    </div>
                                                                    <div
                                                                        class="w-10 h-14 rounded bg-gradient-to-br from-secondary/40 to-accent/40">
                                                                    </div>
                                                                    <div
                                                                        class="w-10 h-14 rounded bg-gradient-to-br from-accent/40 to-primary/40">
                                                                    </div>
                                                                    <% } %>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3
                                                class="font-semibold group-hover:text-primary transition-colors truncate">
                                                <%= list.title %>
                                            </h3>
                                            <p class="text-sm text-base-content/60">
                                                <%= list.description %>
                                            </p>
                                            <% if (list.description) { %>
                                                <p class="text-xs text-base-content/50 truncate mt-1">
                                                    <%= list.count %>
                                                        <%= list.count===1 ? 'film' : 'films' %>
                                                </p>
                                                <% } %>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5 text-base-content/30 group-hover:text-primary transition-colors"
                                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7" />
                                        </svg>
                                    </div>
                                </a>
                                <% }); %>
                                    <% } else { %>
                                        <div class="text-center py-10 text-base-content/50">
                                            <p>No lists yet.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl md:text-2xl font-bold">Recent Activity</h2>
                        <!-- <a href="#" class="btn btn-ghost btn-sm gap-1">
                            View All
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </a> -->
                    </div>

                    <div class="space-y-4">
                        <% if (data.recentActivity && data.recentActivity.length> 0) { %>
                            <% const colors=['primary', 'secondary' , 'accent' , 'info' ]; %>
                                <% data.recentActivity.forEach((activity, index)=> { %>
                                    <div class="card bg-base-100 shadow-md">
                                        <div class="card-body p-4">
                                            <div class="flex items-start gap-3">
                                                <div class="avatar placeholder">
                                                    <div
                                                        class="bg-<%= colors[index % 4] %> text-<%= colors[index % 4] %>-content rounded-full w-10">
                                                        <span class="text-sm font-bold">
                                                            <%= activity.userInitials || 'U' %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm">
                                                        <% if (activity.type==='add' ) { %>
                                                            <span class="text-base-content/60">A movie was added to
                                                            </span>
                                                            <a href="<%= activity.url || ('/watchlists/' + activity.listId) %>"
                                                                class="font-semibold hover:text-primary">
                                                                <%= activity.listTitle %>
                                                            </a>
                                                            <span class="text-base-content/60">: </span>
                                                            <a href="/movies/<%= activity.movieId %>"
                                                                class="font-semibold text-primary hover:underline">
                                                                <%= activity.movieTitle %>
                                                            </a>
                                                            <% } else { %>
                                                                <span class="font-semibold">
                                                                    <%= activity.userName %>
                                                                </span>
                                                                <span class="text-base-content/60">
                                                                    <%= activity.type==='review' ? 'reviewed' : 'rated'
                                                                        %>
                                                                </span>
                                                                <a href="/movies/<%= activity.movieId %>"
                                                                    class="font-semibold text-primary hover:underline">
                                                                    <%= activity.movieTitle %>
                                                                </a>
                                                                <% } %>
                                                    </p>
                                                    <% if (activity.review) { %>
                                                        <p class="text-sm text-base-content/60 mt-1 line-clamp-2">
                                                            <%= activity.review %>
                                                        </p>
                                                        <% } %>
                                                            <% if (activity.rating> 0) { %>
                                                                <div class="flex items-center gap-1 mt-2">
                                                                    <div class="rating rating-sm rating-half">
                                                                        <input type="radio" name="rating-<%= index %>"
                                                                            class="rating-hidden" />
                                                                        <% for (let i=1; i <=5; i++) { %>
                                                                            <input type="radio"
                                                                                name="rating-<%= index %>"
                                                                                class="mask mask-star-2 mask-half-1 bg-warning"
                                                                                disabled <%=activity.rating===(i - 0.5)
                                                                                ? 'checked' : '' %> />
                                                                            <input type="radio"
                                                                                name="rating-<%= index %>"
                                                                                class="mask mask-star-2 mask-half-2 bg-warning"
                                                                                disabled <%=activity.rating===i
                                                                                ? 'checked' : '' %> />
                                                                            <% } %>
                                                                    </div>
                                                                </div>
                                                                <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-10 text-base-content/50">
                                                <p>No recent activity yet.</p>
                                            </div>
                                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="relative bg-base-100 px-4 py-24 overflow-hidden border-t border-base-200">
        <!-- Background Ambient Glow -->
        <div class="absolute -top-40 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[128px] pointer-events-none"></div>
        <div class="absolute -bottom-40 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-[128px] pointer-events-none"></div>

        <div class="mx-auto max-w-6xl relative z-10">
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
                <div class="max-w-xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wide uppercase mb-4">
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                        Built for movie lovers
                    </div>
                    <h2 class="text-3xl md:text-5xl font-black tracking-tight text-base-content leading-tight">
                        Your movie life,<br class="hidden sm:inline" /> all in one place.
                    </h2>
                </div>
                <p class="text-base md:text-lg text-base-content/70 max-w-md">
                    No clutter, no noise. Just a clean home for logging what you watch, building lists, and trading recommendations.
                </p>
            </div>

            <!-- Bento Feature Layout -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Hero Card 1: Film Diary -->
                <div class="md:col-span-2 card bg-base-200/40 hover:bg-base-200/70 border border-base-content/10 transition-all duration-300 group overflow-hidden">
                    <div class="card-body p-8 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="p-2.5 rounded-lg bg-primary/10 text-primary group-hover:scale-110 transition-transform">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                                    </svg>
                                </span>
                                <h3 class="card-title text-xl md:text-2xl font-bold">The Ultimate Personal Film Diary</h3>
                            </div>
                            <p class="text-base-content/70 max-w-lg mb-6 leading-relaxed">
                                Record every movie you watch with exact dates, star ratings, and personal reviews. Keep a running memory of your cinematic journey.
                            </p>
                        </div>

                        <!-- Visual Card Mockup -->
                        <div class="bg-base-100 rounded-xl p-4 border border-base-content/10 shadow-lg flex items-center gap-4 max-w-md group-hover:translate-x-1 transition-transform">
                            <div class="w-12 h-16 rounded bg-gradient-to-br from-primary/30 to-secondary/30 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" /></svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between text-xs text-base-content/50 mb-1">
                                    <span>Watched Today</span>
                                    <span class="text-amber-400 font-semibold">★★★★★</span>
                                </div>
                                <h4 class="font-bold text-sm text-base-content truncate">Dune: Part Two</h4>
                                <p class="text-xs text-base-content/60 italic truncate">"An absolute masterpiece of scale and sound."</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Custom Lists -->
                <div class="card bg-base-200/40 hover:bg-base-200/70 border border-base-content/10 transition-all duration-300 group">
                    <div class="card-body p-8 flex flex-col justify-between">
                        <div>
                            <div class="p-2.5 w-fit rounded-lg bg-secondary/10 text-secondary mb-4 group-hover:scale-110 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                            </div>
                            <h3 class="card-title text-xl font-bold mb-2">Curated Lists</h3>
                            <p class="text-base-content/70 text-sm leading-relaxed mb-4">
                                Rank director filmographies, build marathon watchlists, or craft hyper-specific thematic collections.
                            </p>
                        </div>
                        <div class="flex flex-wrap gap-2 pt-2">
                            <span class="badge badge-sm badge-outline border-base-content/20 text-xs">#35mm-Gems</span>
                            <span class="badge badge-sm badge-outline border-base-content/20 text-xs">#90s-SciFi</span>
                            <span class="badge badge-sm badge-outline border-base-content/20 text-xs">#October-Horror</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Social & Friends -->
                <div class="card bg-base-200/40 hover:bg-base-200/70 border border-base-content/10 transition-all duration-300 group">
                    <div class="card-body p-8 flex flex-col justify-between">
                        <div>
                            <div class="p-2.5 w-fit rounded-lg bg-accent/10 text-accent mb-4 group-hover:scale-110 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                            </div>
                            <h3 class="card-title text-xl font-bold mb-2">Friend Activity</h3>
                            <p class="text-base-content/70 text-sm leading-relaxed">
                                See what your friends are watching tonight, read their hot takes, and discover films you'd otherwise miss.
                            </p>
                        </div>
                        <div class="pt-4 border-t border-base-content/10 flex items-center gap-3">
                            <div class="avatar-group -space-x-3">
                                <div class="avatar placeholder"><div class="w-7 bg-primary text-primary-content rounded-full"><span class="text-xs font-bold">AL</span></div></div>
                                <div class="avatar placeholder"><div class="w-7 bg-secondary text-secondary-content rounded-full"><span class="text-xs font-bold">MK</span></div></div>
                                <div class="avatar placeholder"><div class="w-7 bg-accent text-accent-content rounded-full"><span class="text-xs font-bold">JD</span></div></div>
                            </div>
                            <span class="text-xs text-base-content/60 font-medium">+ Real-time activity</span>
                        </div>
                    </div>
                </div>

                <!-- Hero Card 4: Viewing Habits & Stats -->
                <div class="md:col-span-2 card bg-base-200/40 hover:bg-base-200/70 border border-base-content/10 transition-all duration-300 group overflow-hidden">
                    <div class="card-body p-8 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center gap-3 mb-4">
                                <span class="p-2.5 rounded-lg bg-info/10 text-info group-hover:scale-110 transition-transform">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                    </svg>
                                </span>
                                <h3 class="card-title text-xl md:text-2xl font-bold">Viewing Habits & Stats</h3>
                            </div>
                            <p class="text-base-content/70 max-w-lg mb-6 leading-relaxed">
                                Track your yearly totals, favorite genres, top actors, and weekly viewing patterns with clear, visual breakdowns.
                            </p>
                        </div>

                        <!-- Mini Stats Bar Graphic -->
                        <div class="grid grid-cols-3 gap-3 max-w-md">
                            <div class="bg-base-100 p-3 rounded-lg border border-base-content/10 text-center">
                                <span class="text-xs text-base-content/60 uppercase tracking-wider block mb-1">This Year</span>
                                <span class="text-lg font-black text-primary">124 Films</span>
                            </div>
                            <div class="bg-base-100 p-3 rounded-lg border border-base-content/10 text-center">
                                <span class="text-xs text-base-content/60 uppercase tracking-wider block mb-1">Top Genre</span>
                                <span class="text-lg font-black text-secondary">Sci-Fi</span>
                            </div>
                            <div class="bg-base-100 p-3 rounded-lg border border-base-content/10 text-center">
                                <span class="text-xs text-base-content/60 uppercase tracking-wider block mb-1">Avg Rating</span>
                                <span class="text-lg font-black text-warning">4.2 ★</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-primary/10 via-base-200 to-secondary/10 px-4 py-20">
        <div class="mx-auto max-w-3xl text-center">
            <h2 class="mb-4 text-3xl md:text-4xl font-bold">Start your film journey today</h2>
            <p class="mb-8 text-lg text-base-content/60">
                Join to start tracking your film journey with over 1,200,000 films to track, rate, and share.
            </p>
            <a href="/login"
                class="btn btn-primary btn-lg gap-2 shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-primary/25">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
